OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# The second Cascade voice: diarized speaker 1 is spoken with this one, so a
# two-party conversation does not come back in a single voice.
ELEVENLABS_VOICE_ID_SPEAKER_B=ErXwobaYiN019PkySvjV
# Optional Realtime-mode server-VAD tuning (leave unset for OpenAI defaults).
# COMPARISON.md section 2 measured 58% acceptable at defaults vs 94% with these two:
# REALTIME_VAD_SILENCE_MS=900
# REALTIME_VAD_INTERRUPT_RESPONSE=false

# Further ElevenLabs voice ids to offer in the tuning panel's TTS voice
# pickers, alongside ELEVENLABS_VOICE_ID and the speaker-B voice.
# **Comma-separated**, not JSON (unlike CORS_ORIGINS below):
# ELEVENLABS_VOICE_IDS_EXTRA=pNInz6obpgDQGcFmaJgB,EXAVITQu4vr4xnSDxMaL

# Origins allowed to call the HTTP API *and* to open the /ws/cascade
# WebSocket -- that guard is the only thing stopping an arbitrary page in a
# developer's browser from opening a session against these real keys, so add
# an origin only if you own it. **JSON list**, and setting it replaces the
# default (5173 = `npm run dev`, 5183 = the Playwright harness):
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5183"]
