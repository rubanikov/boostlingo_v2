# Ticket 8: TTS-generated audio fixtures (tests/fixtures/generate_audio_fixtures.py).
# Regenerated on demand from interpreter_dataset.json, not hand-authored, not
# meant to be committed as binary blobs.
backend/tests/fixtures/audio/

# Real (non-TTS) recordings for run_real_audio_report.py: personal audio of
# whoever recorded them, plus the manifest naming what they said. Keep
# manifest.example.json tracked as the template; nothing else in this
# directory belongs in the repo.
backend/tests/fixtures/real_audio/*.wav
backend/tests/fixtures/real_audio/manifest.json
backend/tests/fixtures/real_audio_report.json

# Same reasoning for the Realtime-mode quality corpus (recorder.html's second
# prompt set): personal recordings of the 33 dataset items. SCRIPT.md (what
# to say) stays tracked; the audio and manifest do not.
backend/tests/fixtures/realtime_quality/*.wav
backend/tests/fixtures/realtime_quality/manifest.json
backend/tests/fixtures/realtime_quality/captures*.json
backend/tests/fixtures/realtime_quality/.padded/
backend/tests/fixtures/realtime_quality_report*.json

# Node / frontend
frontend/node_modules/
frontend/dist/

# Real (non-TTS) speech recording for the Playwright E2E harness -- personal
# audio of whoever recorded it, same reasoning as backend/tests/fixtures/real_audio/.
frontend/e2e/fixtures/real-speech.wav

